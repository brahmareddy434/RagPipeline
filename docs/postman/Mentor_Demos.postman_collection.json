{
  "info": {"name": "Week 8 and 9 mentor demo contracts", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Local read-only fictional demo checks. Run with --no-report-events. Live model runs are separately captured by course.mentor_demo_smoke."},
  "variable": [{"key": "base_url", "value": "http://127.0.0.1:8000"}],
  "item": [
    {"name": "Week 9 before discovery", "request": {"method": "GET", "url": "{{base_url}}/api/v1/mcp/demo/tools?variant=before"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Two real policy tools',()=>{pm.response.to.have.status(200);const r=pm.response.json();pm.expect(r.count).to.equal(2);pm.expect(r.names.every(n=>n.startsWith('policy__'))).to.be.true;pm.expect(r.count).to.equal(r.tools_list_responses.reduce((n,p)=>n+p.response.tools.length,0));});"]}}]},
    {"name": "Week 9 after discovery", "request": {"method": "GET", "url": "{{base_url}}/api/v1/mcp/demo/tools?variant=after"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Four real discovered tools',()=>{pm.response.to.have.status(200);const r=pm.response.json();pm.expect(r.count).to.equal(4);pm.expect(r.names).to.include('claims__get_claim_status');pm.expect(r.names).to.include('claims__get_adjuster_notes');pm.expect(r.count).to.equal(r.tools_list_responses.reduce((n,p)=>n+p.response.tools.length,0));});"]}}]},
    {"name": "Reject arbitrary MCP profile", "request": {"method": "GET", "url": "{{base_url}}/api/v1/mcp/demo/tools?variant=untrusted"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Profile allowlist enforced',()=>pm.response.to.have.status(422));"]}}]},
    {"name": "Reject missing claim ID", "request": {"method": "POST", "url": "{{base_url}}/api/v1/claims/demo/run", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"task\":\"What is the status?\",\"variant\":\"before\"}"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Requires one fictional claim',()=>{pm.response.to.have.status(400);pm.expect(pm.response.json().detail).to.include('exactly one');});"]}}]},
    {"name": "Reject client budget override", "request": {"method": "POST", "url": "{{base_url}}/api/v1/claims/demo/run", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"task\":\"Status CLM-2026-10004?\",\"variant\":\"after\",\"budget\":{\"max_tokens\":200000}}"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Fixed demo budget cannot be overridden',()=>pm.response.to.have.status(422));"]}}]},
    {"name": "Week 10 proposed AgentCard", "request": {"method": "GET", "url": "{{base_url}}/api/v1/claims/team/agent-card"}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('AgentCard advertises claims skill and JSON modes without claiming A2A transport',()=>{pm.response.to.have.status(200);const c=pm.response.json();pm.expect(c.skills.some(s=>s.id==='claims-triage')).to.be.true;pm.expect(c.defaultInputModes).to.include('application/json');pm.expect(c.defaultOutputModes).to.include('application/json');pm.expect(c).to.have.property('securitySchemes');pm.expect(c.description).to.include('administrative summaries only');});"]}}]},
    {"name": "Reject task for a different claim", "request": {"method": "POST", "url": "{{base_url}}/api/v1/claims/team/run", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"claim_id\":\"CLM-2026-10001\",\"task\":\"Summarize CLM-2026-10002\",\"arm\":\"failure\"}"}}, "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Selected claim must match the submitted question',()=>pm.response.to.have.status(422));"]}}]}
  ]
}
