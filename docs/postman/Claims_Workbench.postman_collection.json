{
  "info":{"name":"Claims Workbench local contract smoke","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json","description":"Read-only fictional fixture checks against a real local backend. Run with --no-report-events. No tokens are embedded."},
  "variable":[{"key":"base_url","value":"http://127.0.0.1:18766"}],
  "item":[
    {"name":"Session","request":{"method":"GET","url":"{{base_url}}/api/v1/session"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Local identity',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().tenant).to.equal('local');});"]}}]},
    {"name":"Claims fixtures","request":{"method":"GET","url":"{{base_url}}/api/v1/claims/fixtures"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Ten fictional claims and three tools',()=>{pm.response.to.have.status(200);const r=pm.response.json();pm.expect(r.claims.length).to.equal(10);pm.expect(r.tools.length).to.equal(3);});"]}}]},
    {"name":"Deterministic evaluation","request":{"method":"GET","url":"{{base_url}}/api/v1/claims/evaluation"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Thirty cases, four assertions, one pending judge',()=>{pm.response.to.have.status(200);const r=pm.response.json();pm.expect(r.cases.length).to.equal(30);pm.expect(r.deterministic_criteria).to.equal(4);pm.expect(r.judge_criteria).to.equal(1);});"]}}]},
    {"name":"Reject invalid question","request":{"method":"POST","url":"{{base_url}}/api/v1/tools/run","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"question\":\"\"}"}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Safe 422',()=>{pm.response.to.have.status(422);pm.expect(pm.response.json().detail[0]).not.to.have.property('input');});"]}}]},
    {"name":"MCP inventory","request":{"method":"GET","url":"{{base_url}}/api/v1/mcp/tools"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Actual discovered tools',()=>{pm.response.to.have.status(200);const r=pm.response.json();pm.expect(r.count).to.equal(r.tools_list_responses.reduce((n,p)=>n+p.response.tools.length,0));pm.expect(r.count).to.equal(4);});"]}}]},
    {"name":"Benchmark reports","request":{"method":"GET","url":"{{base_url}}/api/v1/claims/benchmarks"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Reviewed benchmark report shape',()=>{pm.response.to.have.status(200);const r=pm.response.json();pm.expect(r.reports).to.be.an('object');pm.expect(r.notice).to.include('fictional');});"]}}]}
  ]
}
